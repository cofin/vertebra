{
  "files.exclude": {
    "**/._*": true,
    "**/*.pyc": {
      "when": "$(basename).py"
    },
    "**/.mypy_cache": true,
    "**/.tanstack": true,
    "**/__pycache__": true,
    ".venv": true,
    ".venv-ft": true,
    ".idea": true,
    ".run": true,
    ".pytest_cache": true,
    "**/.cache": true,
    "**/.dist": true,
    "**/.pytest_cache": true,
    "site": true,
    "**/.angular": true,
    "**/.ruff_cache": true,
    "**/.unasyncd_cache": true,
    "**/.coverage": true,
    "**/coverage": true,
    "**/node_modules": true,
    "**/.terraform": true,
    "tmp": false,
    "scratch": true,
    "**/.static": true,
    "dist": false,
    ".dmypy.json": true,
    ".claude": true,
    ".beads": true,
    ".gemini": true,
    "**/*/tsconfig.tsbuildinfo": true,
    ".cargo": true
  },
  "cSpell.words": [
    "archlogs",
    "awrhistcmdtypes",
    "awrhistosstat",
    "awrhistsysmetrichist",
    "awrhistsysmetricsumm",
    "awrsnapdetails",
    "CMNT",
    "compressbytype",
    "cpucoresusage",
    "createemptyfile",
    "dataguard",
    "dbahistsysstat",
    "dbahistsystimemodel",
    "dbfeatures",
    "dbhwmarkstatistics",
    "dbinstances",
    "dblinks",
    "dbobjects",
    "dbparameters",
    "DBSIZING",
    "dbsummary",
    "exttab",
    "FAILEDSTATUS",
    "filterrows",
    "idxpertable",
    "ifcondition",
    "importcomment",
    "indexestypes",
    "indextypes",
    "invalidfiles",
    "ioevents",
    "iofunction",
    "IOSTAT",
    "JOBPARAMS",
    "LOADDATE",
    "LOADTOBQDATE",
    "lobsizing",
    "machinesizes",
    "METAVARS",
    "mview",
    "mviewtypes",
    "nodataframe",
    "notabname",
    "occurrences",
    "opalldb",
    "opdb",
    "opdbt",
    "operrors",
    "opkeylog",
    "optimusconfig",
    "ORCLCDB",
    "OSSTAT",
    "pdbs",
    "pdbsinfo",
    "pdbsopenmode",
    "PERC",
    "pkey",
    "pkeys",
    "SESS",
    "snav",
    "sourcecode",
    "SQLSTAT",
    "SQLTEXT",
    "statspack",
    "SUBPARTITIONS",
    "SYSMETRIC",
    "SYSSTAT",
    "TABLESPACES",
    "tabletypes",
    "topsql",
    "vsysstat"
  ],
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "notebook.formatOnSave.enabled": true,
  "evenBetterToml.formatter.reorderKeys": true,
  "evenBetterToml.formatter.trailingNewline": true,
  "evenBetterToml.formatter.columnWidth": 120,
  "evenBetterToml.formatter.arrayAutoCollapse": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.ruff": "explicit",
    "source.organizeImports.ruff": "explicit",
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "sqltools.disableReleaseNotifications": true,
  "sqltools.disableNodeDetectNotifications": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "pyproject.toml": "pyproject.toml,uv.lock,poetry.lock,poetry.toml,mkdocs.yaml,.gcloudignore,.gitignore,.geminiignore,.editorconfig,.bumpversion.cfg,.pylintrc,.pre-commit-config.yaml,LICENSE,mkdocs.yml,service_account.json,.python-version,.codecov.yml",
    ".env": ".env*,.*.env",
    "AGENTS.md": "AGENTS.md, AGENTS_*.md, CLAUDE.md, GEMINI.md, .gemini, .geminiignore",
    "docker-compose.yml": "docker-compose.yml, docker-compose.*.yml, .dockerignore",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, tsconfig.*.json, tsconfig.json, .stylelintrc.json,angular.json,proxy.conf.json,cypress.*.ts,extra-webpack*.cjs,.eslintrc.json, biome.json, components.json, vite.config.js, tsconfig.json, vite.config.js, .cta.json, postcss.config.js, tailwind.config.js, vite.config.ts, hey-api.config.ts"
  },
  "terminal.integrated.allowChords": false,
  "terminal.integrated.sendKeybindingsToShell": true,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.trimAutoWhitespace": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "python.analysis.fixAll": [
    "source.unusedImports",
    "source.convertImportFormat"
  ],
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.testing.pytestArgs": ["src/py/tests"],
  "python.testing.unittestEnabled": false,
  "python.analysis.supportDocstringTemplate": true,
  "python.analysis.supportRestructuredText": true,
  "python.analysis.regenerateStdLibIndices": true,
  "python.analysis.showOnlyDirectDependenciesInAutoImport": false,
  "python.analysis.includeAliasesFromUserFiles": true,
  "python.analysis.generateWithTypeAnnotation": true,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.terminal.executeInFileDir": true,
  "python.testing.pytestEnabled": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.autoFormatStrings": true,
  "geminicodeassist.enable": true,
  "python.analysis.languageServerMode": "full",
  "python.terminal.shellIntegration.enabled": true,
  "ruff.configuration": "${workspaceFolder}/pyproject.toml",
  "ruff.nativeServer": "auto",
  "ruff.lint.preview": true,
  "ruff.format.preview": true,
  "ruff.lineLength": 120,
  "ruff.lint.extendSelect": ["ALL"],
  "ruff.lint.select": ["ALL"],
  "ruff.configurationPreference": "filesystemFirst",
  "python.analysis.typeCheckingMode": "strict",
  "Prettier-SQL.SQLFlavourOverride": "postgresql",
  "Prettier-SQL.indentStyle": "tabularLeft",
  "Prettier-SQL.denseOperators": true,
  "Prettier-SQL.expressionWidth": 120,
  "Prettier-SQL.tabulateAlias": true,
  "Prettier-SQL.commaPosition": "tabular",
  "Prettier-SQL.ignoreTabSettings": true,
  "Prettier-SQL.keywordCase": "upper",
  "sqlfluff.dialect": "postgres",
  "sqlfluff.env.useDotEnvFile": true,
  "sqlfluff.format.languages": [
    "pgpglsql",
    "plsql",
    "sql",
    "sql-bigquery",
    "jinja-sql",
    "postgres",
    "snowflake-sql"
  ],
  "sqlfluff.linter.run": "onSave",
  "sqlfluff.ignoreParsing": true,
  "sqlfluff.suppressNotifications": true,
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true,
    "**/src/lib/api/types.gen.ts": true,
    "**/src/lib/api/*.gen.ts": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true,
    "**/src/lib/api/types.gen.ts": true,
    "**/src/lib/api/*.gen.ts": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true,
    "**/src/lib/api/types.gen.ts": true,
    "**/src/lib/api/*.gen.ts": true
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[graphql]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "emmet.showExpandedAbbreviation": "never",
  "sqltools.format": {
    "linesBetweenQueries": 2,
    "reservedWordCase": "null",
    "language": "pl/sql"
  },
  "SQL-Formatter-VSCode.linesBetweenQueries": 2,
  "SQL-Formatter-VSCode.expressionWidth": 180,
  "SQL-Formatter-VSCode.indentStyle": "standard",
  "SQL-Formatter-VSCode.dialect": "postgresql",
  "SQL-Formatter-VSCode.paramTypes": {
    "positional":true, "numbered":[":","$"], "named": [":", "$"]
  },
  "SQL-Formatter-VSCode.functionCase": "lower",
  "SQL-Formatter-VSCode.identifierCase": "lower",
  "SQL-Formatter-VSCode.dataTypeCase": "lower",
  "biome.rename": true,
  "biome.lsp.bin": "src/js/web/node_modules/@biomejs/biome/bin/biome",
  "githubRepositories.autoFetch.interval": 3600,
  "git.autofetchPeriod": 3600,
  "debug.javascript.resourceRequestOptions": {

  }
}
