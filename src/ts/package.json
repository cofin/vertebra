{
  "name": "vertebra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "dev": "bun run src/server/serve.ts",
    "build": "bunx tsc --noEmit && bunx @biomejs/biome check src/ --files-ignore-unknown=true --no-errors-on-unmatched",
    "check": "bunx tsc --noEmit",
    "lint": "bunx @biomejs/biome check --write --unsafe src/ --files-ignore-unknown=true --no-errors-on-unmatched",
    "format": "bunx @biomejs/biome format --write src/",
    "build:engine": "bun run ../../src/py/vertebra/build/tools/build-cli.ts",
    "build:engine:linux": "bun run ../../src/py/vertebra/build/tools/build-cli.ts --target linux-x64",
    "build:engine:macos": "bun run ../../src/py/vertebra/build/tools/build-cli.ts --target darwin-arm64"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@types/bun": "latest",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@iarna/toml": "^3.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "apache-arrow": "^14.0.2",
    "jose": "^6.1.3",
    "prom-client": "^15.1.3"
  }
}
