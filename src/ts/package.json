{
  "name": "vertebra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "dev": "bun run src/server/serve.ts",
    "build": "bunx tsc --noEmit && bunx @biomejs/biome check src/ --files-ignore-unknown=true --no-errors-on-unmatched",
    "check": "bunx tsc --noEmit",
    "lint": "bunx @biomejs/biome check --write --unsafe src/ --files-ignore-unknown=true --no-errors-on-unmatched",
    "format": "bunx @biomejs/biome format --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@iarna/toml": "^3.0.0",
    "@msgpack/msgpack": "^3.0.0",
    "apache-arrow": "^14.0.0",
    "prom-client": "^15.1.0"
  }
}
