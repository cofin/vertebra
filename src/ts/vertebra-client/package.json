{
  "name": "@vertebra/client",
  "version": "0.3.0",
  "description": "TypeScript client SDK for Vertebra — one runtime for Python and TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "import": "./dist/angular/index.js"
    },
    "./htmx": {
      "types": "./dist/htmx/index.d.ts",
      "import": "./dist/htmx/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./hmr": {
      "types": "./dist/hmr/index.d.ts",
      "import": "./dist/hmr/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js"
    },
    "./arrow": {
      "types": "./dist/arrow.d.ts",
      "import": "./dist/arrow.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "import": "./dist/live/index.js"
    },
    "./apex": {
      "types": "./dist/apex/index.d.ts",
      "import": "./dist/apex/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./webmcp": {
      "types": "./dist/webmcp.d.ts",
      "import": "./dist/webmcp.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vue": "^3.5.0",
    "svelte": "^5.0.0",
    "@angular/core": "^22.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^22.2.6",
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^5.9.3",
    "tsup": "^8.5.1",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "svelte": "^5.57.3",
    "vite": "^8.3.8"
  }
}
