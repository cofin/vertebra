from __future__ import annotations

import collections
from typing import Any, Mapping

class Buffer:
    def len(self) -> int: ...
    def read(self) -> bytes: ...
    def write(self, data: bytes) -> None: ...

class BufferChannel:
    def __init__(self, buffer_size: int, count: int, slots: int) -> None: ...
    def acquire(self) -> Buffer | None: ...
    def send(self, buffer: Buffer, length: int, flags: int) -> None: ...
    def recv(self) -> tuple[Buffer, int, int]: ...

class BufferPool:
    def __init__(self, slot_size: int, slots: int) -> None: ...
    def acquire(self) -> Buffer | None: ...

class Channel:
    def __init__(self, slot_size: int, slots: int) -> None: ...
    @classmethod
    def create_pair(cls, slot_size: int, slots: int) -> tuple[Channel, Channel]: ...
    @classmethod
    def create_named(cls, name: str, slot_size: int, slots: int, role: str) -> Channel: ...
    @classmethod
    def open_named(cls, name: str, slot_size: int, slots: int, role: str) -> Channel: ...
    def payload_capacity(self) -> int: ...
    def send_request(self, data: bytes) -> None: ...
    def try_send_request(self, data: bytes) -> bool: ...
    def recv_request(self, max_len: int) -> bytes: ...
    def try_recv_request(self, max_len: int) -> bytes | None: ...
    def send_response(self, data: bytes) -> None: ...
    def try_send_response(self, data: bytes) -> bool: ...
    def recv_response(self, max_len: int) -> bytes: ...
    def try_recv_response(self, max_len: int) -> bytes | None: ...

class MpmcRing:
    def __init__(self, slot_size: int, slots: int) -> None: ...
    def send(self, data: bytes, flags: int) -> None: ...
    def recv(self, max_len: int) -> bytes: ...
    def try_send(self, data: bytes, flags: int) -> bool: ...
    def try_recv(self, max_len: int) -> bytes | None: ...

class ShmRegion:
    @classmethod
    def create_named(cls, name: str, size: int) -> ShmRegion: ...
    @classmethod
    def open_named(cls, name: str, size: int) -> ShmRegion: ...
    def len(self) -> int: ...
    def read(self, offset: int, length: int) -> bytes: ...
    def write(self, offset: int, data: bytes) -> None: ...
    def as_memoryview(self) -> memoryview: ...
    def close(self) -> None: ...
    def __enter__(self) -> ShmRegion: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: object | None,
    ) -> bool: ...
    # Buffer protocol support
    def __buffer__(self, flags: int) -> memoryview: ...

class SpscRing:
    @classmethod
    def create_named(cls, name: str, slot_size: int, slots: int) -> SpscRing: ...
    @classmethod
    def open_named(cls, name: str, slot_size: int, slots: int) -> SpscRing: ...
    def send(self, data: bytes, flags: int) -> None: ...
    def send_timeout(self, data: bytes, flags: int, timeout_ms: int) -> bool: ...
    def recv(self, max_len: int) -> bytes: ...
    def recv_timeout(self, max_len: int, timeout_ms: int) -> bytes | None: ...
    def try_send(self, data: bytes, flags: int) -> bool: ...
    def try_recv(self, max_len: int) -> bytes | None: ...
    def close(self) -> None: ...

class AsyncRing:
    @classmethod
    def create_named(cls, name: str, slot_size: int, slots: int) -> AsyncRing: ...
    @classmethod
    def open_named(cls, name: str, slot_size: int, slots: int) -> AsyncRing: ...
    def notifier_fd(self) -> int: ...
    def payload_capacity(self) -> int: ...
    def send(self, data: bytes, flags: int | None = None) -> None: ...
    def try_send(self, data: bytes, flags: int | None = None) -> bool: ...
    def try_recv(self) -> bytes | None: ...
    def try_recv_with_flags(self) -> tuple[bytes, int] | None: ...
    def clear_notification(self) -> None: ...
    def has_pending_notification(self) -> bool: ...
    def stats(self) -> dict[str, int]: ...

class AsyncChannel:
    @classmethod
    def create_pair(cls, slot_size: int, slots: int) -> tuple[AsyncChannel, AsyncChannel]: ...
    @classmethod
    def create_named(cls, name: str, slot_size: int, slots: int, role: str) -> AsyncChannel: ...
    @classmethod
    def open_named(cls, name: str, slot_size: int, slots: int, role: str) -> AsyncChannel: ...
    def request_notifier_fd(self) -> int: ...
    def response_notifier_fd(self) -> int: ...
    def send_request(self, data: bytes) -> None: ...
    def try_send_request(self, data: bytes) -> bool: ...
    def try_recv_request(self) -> bytes | None: ...
    def send_response(self, data: bytes) -> None: ...
    def try_send_response(self, data: bytes) -> bool: ...
    def try_recv_response(self) -> bytes | None: ...
    def clear_request_notification(self) -> None: ...
    def clear_response_notification(self) -> None: ...
    def has_pending_request(self) -> bool: ...
    def has_pending_response(self) -> bool: ...

class PooledAsyncRing:
    def __init__(self, slot_size: int, slots: int, pool_size: int) -> None: ...
    def notifier_fd(self) -> int: ...
    def send(self, data: bytes, flags: int | None = None) -> None: ...
    def try_send(self, data: bytes, flags: int | None = None) -> bool: ...
    def try_recv(self) -> bytes | None: ...
    def clear_notification(self) -> None: ...
    def pool_available(self) -> int: ...

# Module-level functions
def shm_unlink(name: str) -> None: ...

# Module version
__version__: str