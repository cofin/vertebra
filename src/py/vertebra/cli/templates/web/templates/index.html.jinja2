<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ project_name }} - Vertebra</title>
    <link rel="stylesheet" href="/static/styles.css">
    <style>
        :root {
            --primary: #1e3a5f;
            --accent: #d4af37;
            --bg: #f8fafc;
            --text: #1e293b;
        }
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        header {
            background-color: var(--primary);
            color: white;
            padding: 2rem;
            text-align: center;
        }
        .container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 1rem;
            flex: 1;
        }
        .hero h1 {
            font-size: 3rem;
            margin-bottom: 0.5rem;
        }
        .hero p {
            font-size: 1.25rem;
            opacity: 0.9;
        }
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 3rem;
        }
        .card {
            background: white;
            padding: 1.5rem;
            border-radius: 8px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        }
        .card h3 {
            margin-top: 0;
            color: var(--primary);
        }
        .card .icon {
            font-size: 2rem;
            margin-bottom: 1rem;
        }
        code {
            background: #e2e8f0;
            padding: 0.2rem 0.4rem;
            border-radius: 4px;
            font-family: monospace;
        }
        .cta {
            margin-top: 3rem;
            text-align: center;
        }
        .btn {
            background-color: var(--accent);
            color: var(--primary);
            padding: 0.75rem 1.5rem;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
        }
        footer {
            text-align: center;
            padding: 2rem;
            font-size: 0.875rem;
            opacity: 0.7;
        }
    </style>
</head>
<body>
    <header>
        <div class="hero">
            <h1>{{ project_name }}</h1>
            <p>Built with Vertebra V2 (Native Rust Core)</p>
        </div>
    </header>

    <div class="container">
        <div class="feature-grid">
            <div class="card">
                <div class="icon">🚀</div>
                <h3>High Performance</h3>
                <p>Zero-copy shared memory IPC and Native Rust HTTP server powered by Hyper.</p>
            </div>
            <div class="card">
                <div class="icon">⚡</div>
                <h3>Real-time Sync</h3>
                <p>Server-Sent Events (SSE) and State Synchronization between workers.</p>
            </div>
            <div class="card">
                <div class="icon">🛠️</div>
                <h3>Type Safe</h3>
                <p>Automatic TypeScript type generation from Python procedures.</p>
            </div>
        </div>

        <div class="cta">
            <p>Get started by editing <code>src/{{ project_slug }}/handlers.py</code></p>
            <a href="/health" class="btn">Check System Health</a>
        </div>
    </div>

    <footer>
        Vertebra {{ vertebra_version }} • <a href="https://github.com/cofin/vertebra">GitHub</a>
    </footer>
</body>
</html>
